{
  "name": "horario",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
