DATABASE_URL=postgres://horario:horario@localhost:5432/horario
# Opt-in, leave unset in normal dev/production (defaults to postgres-js
# against DATABASE_URL above). Only the Playwright e2e suite sets this, to
# 'pglite' — see tests/e2e/env.ts and src/db/client.ts.
# DATABASE_DRIVER=pglite
# Only read when DATABASE_DRIVER=pglite: the directory a file-backed PGlite
# instance persists to.
# PGLITE_DATA_DIR=.data/e2e-pglite
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string-at-least
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=agendamentos@seudominio.com.br
# Env-gated no-op for sendConfirmationEmail, set by the e2e suite so no
# test ever makes a real call to Resend. Leave unset in normal dev/production.
# DISABLE_EMAIL_SEND=true
# Turns off better-auth's default production rate limiting, set only by the
# e2e suite (a fast automated browser can burst past a real production
# budget). Leave unset in normal dev/production.
# DISABLE_AUTH_RATE_LIMIT=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_EMAIL=demo@horario.app
DEMO_PASSWORD=demo12345
CRON_SECRET=change-me-to-a-16-char-random-string
